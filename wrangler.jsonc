/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "panelrift-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-15",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,

	/**
	 * Public reachability.
	 *
	 * The frontend no longer calls this worker over the internet: panelrift's
	 * Pages Function invokes it through the `API` service binding, which is
	 * dispatched inside Cloudflare's network and does not use the hostname below.
	 *
	 * Uncommenting these two lines takes away the public front door, which is what
	 * actually restricts the API to that one caller — an Origin allowlist only ever
	 * constrains browsers, never curl. Flip them *after* confirming a Pages preview
	 * deploy serves /api/* correctly; do it first and the live site loses its API.
	 * Note it also ends direct curl access for debugging.
	 */
	// "workers_dev": false,
	// "preview_urls": false,

	"vars": {
		// Upstream site being scraped. Override per-environment if it ever moves.
		"UPSTREAM_BASE_URL": "https://www.mgeko.cc",
		// Milliseconds before an upstream request is aborted.
		"UPSTREAM_TIMEOUT_MS": "8000",
		// Comma-separated allowlist of browser Origins, or "*" for any.
		"ALLOWED_ORIGINS": "https://panelrift.pages.dev,https://panelrift.eu.cc",
		/**
		 * Image proxy every cover URL is rewritten onto. Covers are NOT served from
		 * UPSTREAM_BASE_URL — the origin is missing some of the files it stores, so
		 * resolving covers against it leaves a scattering of series with a broken
		 * image. Upstream's own pages build this same URL client-side.
		 *
		 * Set to "" to disable the rewrite and point covers back at the origin.
		 */
		"COVER_BASE_URL": "https://imgsrv5.com",
		/**
		 * Size segment in the proxy path. Only the presets upstream itself requests
		 * exist: "288x412" and "157x211" are verified, anything else returns 404.
		 */
		"COVER_SIZE": "288x412"
	},

	/**
	 * Rate limiting.
	 *
	 * `simple.period` only accepts 10 or 60. Counters are enforced per-colo, not
	 * globally, so a distributed client can achieve roughly limit x colo-count.
	 * That is fine for accidental abuse; use a Durable Object if you need exact
	 * global limits.
	 */
	"unsafe": {
		"bindings": [
			{
				// Per-IP budget for cheap reads (/home, /manhwa, /chapters).
				"name": "READ_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 60, "period": 60 }
			},
			{
				// Per-IP budget for search, which clients fire on every keystroke.
				"name": "SEARCH_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1002",
				"simple": { "limit": 20, "period": 10 }
			},
			{
				// Global ceiling on outbound requests to the upstream site. Keyed on a
				// constant so every visitor shares one budget. Protects the origin even
				// when each individual IP is within its own limit.
				"name": "UPSTREAM_LIMITER",
				"type": "ratelimit",
				"namespace_id": "1003",
				"simple": { "limit": 600, "period": 60 }
			}
		]
	}

	/**
	 * Smart Placement
	 * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": {  "mode": "smart" }
}
